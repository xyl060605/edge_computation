+
+bool MebotJpegImage::Append(size_t index, const void* bytes, size_t length) {
+    if (failed) return false;
+    if (bytes == nullptr) { failed = length != 0; return !failed; }
+    if (length == 0) return true;
+    if (index != size || size > kMaxBytes || length > kMaxBytes - size) {
+        failed = true;
+        return false;
+    }
+    const size_t required = size + length;
+    if (required > capacity) {
+        const size_t grown = std::min(kMaxBytes, std::max(required, capacity == 0 ? size_t(16384) : capacity * 2));
+        auto next = static_cast<uint8_t*>(heap_caps_realloc(data, grown, MALLOC_CAP_SPIRAM | MALLOC_CAP_8BIT));
+        if (next == nullptr) { failed = true; return false; }
+        data = next;
+        capacity = grown;
+    }
+    memcpy(data + size, bytes, length);
+    size = required;
+    return true;
+}
