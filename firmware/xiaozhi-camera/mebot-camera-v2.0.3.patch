+#ifndef MEBOT_CAMERA_SERVER_H
+#define MEBOT_CAMERA_SERVER_H
+
+#include <esp_http_server.h>
+#include <array>
+#include "esp32_camera.h"
+
+class MebotCameraServer {
+public:
+    explicit MebotCameraServer(Esp32Camera& camera) : camera_(camera) {}
+    ~MebotCameraServer();
+    MebotCameraServer(const MebotCameraServer&) = delete;
+    MebotCameraServer& operator=(const MebotCameraServer&) = delete;
+    bool Start();
+private:
+    Esp32Camera& camera_;
+    httpd_handle_t server_ = nullptr;
+    std::array<char, 65> key_{};
+    std::array<char, 17> boot_id_{};
+    int64_t last_capture_started_us_ = 0;
+    static esp_err_t CaptureHandler(httpd_req_t* request);
+    esp_err_t Capture(httpd_req_t* request);
+    bool Authorized(httpd_req_t* request) const;
+};
+
+#endif
