+bool Esp32Camera::EncodeFrame(camera_fb_t* frame, MebotJpegImage& output, uint8_t quality) {
+    output.Clear();
+    if (frame == nullptr || frame->buf == nullptr || frame->len == 0 || frame->width == 0 || frame->height == 0) return false;
+    bool encoded = false;
+    if (frame->format == PIXFORMAT_JPEG) {
+        encoded = output.Append(0, frame->buf, frame->len);
+    } else {
+        size_t channels = 0;
+        if (frame->format == PIXFORMAT_RGB565 || frame->format == PIXFORMAT_YUV422) channels = 2;
+        else if (frame->format == PIXFORMAT_RGB888) channels = 3;
+        else if (frame->format == PIXFORMAT_GRAYSCALE) channels = 1;
+        const size_t pixels = size_t(frame->width) * frame->height;
+        if (channels == 0 || pixels > frame->len / channels ||
+            (frame->format == PIXFORMAT_YUV422 && frame->width % 2 != 0)) return false;
+        // v2.0.3's encoder ignores a short callback return. Preserve our own
+        // failure flag and validate JPEG markers before accepting its output.
+        encoded = image_to_jpeg_cb(frame->buf, frame->len, frame->width, frame->height,
+            frame->format, quality, [](void* arg, size_t index, const void* data, size_t length) -> size_t {
+                auto out = static_cast<MebotJpegImage*>(arg);
+                return out->Append(index, data, length) ? length : 0;
+            }, &output);
+    }
+    if (!encoded || output.failed || output.size < 4 || output.size > MebotJpegImage::kMaxBytes ||
+        output.data[0] != 0xff || output.data[1] != 0xd8 ||
+        output.data[output.size - 2] != 0xff || output.data[output.size - 1] != 0xd9) {
+        output.Clear();
+        return false;
+    }
+    return true;
+}
