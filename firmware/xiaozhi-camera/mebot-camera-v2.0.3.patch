+MebotJpegResult Esp32Camera::CopyJpeg(MebotJpegImage& output) {
+    output.Clear();
+    std::unique_lock<std::mutex> lock(camera_mutex_, std::try_to_lock);
+    if (!lock.owns_lock()) return MebotJpegResult::kBusy;
+    if (!initialized_) return MebotJpegResult::kNotReady;
+    // Capture reserves its frame for Explain. An abandoned reservation expires
+    // instead of preventing all local snapshots indefinitely.
+    if (fb_ != nullptr) {
+        if (esp_timer_get_time() - captured_at_us_ <= 5000000) return MebotJpegResult::kBusy;
+        ReleaseCapturedFrame();
+    }
+    FrameReturn fresh;
+    for (int i = 0; i < 2; ++i) {
+        if (fresh.value != nullptr) esp_camera_fb_return(fresh.value);
+        fresh.value = esp_camera_fb_get();
+        if (fresh.value == nullptr) return MebotJpegResult::kCaptureFailed;
+    }
+    const int64_t captured = esp_timer_get_time();
+    if (!EncodeFrame(fresh.value, output, 75)) return MebotJpegResult::kEncodeFailed;
+    output.frame_id = ++frame_sequence_;
+    output.captured_at_us = captured;
+    // fresh returns the driver framebuffer before HTTP begins sending.
+    return MebotJpegResult::kOk;
+}
