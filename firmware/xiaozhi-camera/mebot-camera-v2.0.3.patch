new file mode 100644
--- /dev/null
+++ b/main/boards/common/mebot_camera_server.cc
@@ -0,0 +1,112 @@
+#include "mebot_camera_server.h"
+#include "application.h"
+
+#include <esp_log.h>
+#include <esp_random.h>
+#include <esp_timer.h>
+#include <cstdio>
+#include <cstring>
+#include <new>
+
+namespace {
+constexpr char kTag[] = "MebotCamera";
+constexpr char kHex[] = "0123456789abcdef";
+esp_err_t Error(httpd_req_t* request, const char* status, const char* message) {
+    httpd_resp_set_status(request, status);
+    httpd_resp_set_type(request, "application/json");
+    httpd_resp_set_hdr(request, "Cache-Control", "no-store");
+    return httpd_resp_send(request, message, HTTPD_RESP_USE_STRLEN);
+}
+}
+
+MebotCameraServer::~MebotCameraServer() {
+    if (server_ != nullptr) httpd_stop(server_);
+    // The secret exists only in this process RAM; it is never written to NVS.
+    volatile char* value = key_.data();
+    for (size_t i = 0; i < key_.size(); ++i) value[i] = 0;
+}
+
+bool MebotCameraServer::Start() {
+    if (server_ != nullptr) return true;
+    uint8_t random[40];
+    esp_fill_random(random, sizeof(random));
+    for (size_t i = 0; i < 32; ++i) {
+        key_[i * 2] = kHex[random[i] >> 4];
+        key_[i * 2 + 1] = kHex[random[i] & 15];
+    }
+    for (size_t i = 0; i < 8; ++i) {
+        boot_id_[i * 2] = kHex[random[32 + i] >> 4];
+        boot_id_[i * 2 + 1] = kHex[random[32 + i] & 15];
+    }
+    memset(random, 0, sizeof(random));
+    httpd_config_t config = HTTPD_DEFAULT_CONFIG();
+    config.server_port = 8080;
+    config.ctrl_port = 32769; // Separate from the Wi-Fi provisioning HTTP server.
+    config.task_priority = 2;
+    config.stack_size = 8192;
+    config.max_open_sockets = 2;
+    config.backlog_conn = 2;
+    config.lru_purge_enable = true;
+    config.recv_wait_timeout = 2;
+    config.send_wait_timeout = 2;
+    if (httpd_start(&server_, &config) != ESP_OK) { server_ = nullptr; return false; }
+    httpd_uri_t endpoint = {};
+    endpoint.uri = "/capture";
+    endpoint.method = HTTP_GET;
+    endpoint.handler = &MebotCameraServer::CaptureHandler;
+    endpoint.user_ctx = this;
+    if (httpd_register_uri_handler(server_, &endpoint) != ESP_OK) {
+        httpd_stop(server_);
+        server_ = nullptr;
+        return false;
+    }
+    // The user reads this locally over serial, then pastes it into the local UI.
+    // Do not upload serial logs containing this line.
+    ESP_LOGW(kTag, "LOCAL ONLY: port=8080 path=/capture X-Mebot-Camera-Key=%s", key_.data());
+    return true;
+}
+
+bool MebotCameraServer::Authorized(httpd_req_t* request) const {
+    constexpr char header[] = "X-Mebot-Camera-Key";
+    if (httpd_req_get_hdr_value_len(request, header) != 64) return false;
+    char candidate[65] = {};
+    if (httpd_req_get_hdr_value_str(request, header, candidate, sizeof(candidate)) != ESP_OK) return false;
+    unsigned difference = 0;
+    for (size_t i = 0; i < 64; ++i) difference |= static_cast<unsigned char>(candidate[i] ^ key_[i]);
+    memset(candidate, 0, sizeof(candidate));
+    return difference == 0;
+}
+
+esp_err_t MebotCameraServer::CaptureHandler(httpd_req_t* request) {
+    auto self = static_cast<MebotCameraServer*>(request->user_ctx);
+    try { return self->Capture(request); }
+    catch (const std::bad_alloc&) { return Error(request, "503 Service Unavailable", "{\"error\":\"camera_memory_unavailable\"}"); }
+    catch (...) { return Error(request, "503 Service Unavailable", "{\"error\":\"camera_unavailable\"}"); }
+}
+
+esp_err_t MebotCameraServer::Capture(httpd_req_t* request) {
+    if (!Authorized(request)) return Error(request, "401 Unauthorized", "{\"error\":\"camera_key_required\"}");
+    // Preserve audio: new local captures are refused during an active voice,
+    // connecting, provisioning, upgrading or startup state.
+    if (Application::GetInstance().GetDeviceState() != kDeviceStateIdle)
+        return Error(request, "503 Service Unavailable", "{\"error\":\"voice_or_device_busy\"}");
+    const int64_t now = esp_timer_get_time();
+    if (last_capture_started_us_ != 0 && now - last_capture_started_us_ < 125000)
+        return Error(request, "503 Service Unavailable", "{\"error\":\"capture_rate_limited\"}");
+    last_capture_started_us_ = now;
+    MebotJpegImage image;
+    const auto result = camera_.CopyJpeg(image);
+    if (result != MebotJpegResult::kOk)
+        return Error(request, "503 Service Unavailable", "{\"error\":\"camera_busy_or_unavailable\"}");
+    httpd_resp_set_type(request, "image/jpeg");
+    httpd_resp_set_hdr(request, "Cache-Control", "no-store, max-age=0");
+    httpd_resp_set_hdr(request, "X-Content-Type-Options", "nosniff");
+    char id[48], captured[32];
+    snprintf(id, sizeof(id), "%s-%llu", boot_id_.data(), static_cast<unsigned long long>(image.frame_id));
+    snprintf(captured, sizeof(captured), "%lld", static_cast<long long>(image.captured_at_us));
+    httpd_resp_set_hdr(request, "X-Mebot-Frame-Id", id);
+    httpd_resp_set_hdr(request, "X-Mebot-Captured-Us", captured);
+    // Synchronous send returns on success, timeout or client disconnect; image's
+    // destructor frees its independent PSRAM buffer on every exit path.
+    return httpd_resp_send(request, reinterpret_cast<const char*>(image.data), image.size);
+}
